POSTGRES_DB=aparts
POSTGRES_USER=aparts
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://aparts:replace-with-a-long-random-password@postgres:5432/aparts

NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NUXT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
NUXT_ORGANIZATION_NAME=Aparts

NUXT_PUBLIC_APP_URL=https://crm.aparts-bansko.com
FILE_STORAGE_PATH=/app/.data/uploads

NUXT_BREVO_API_KEY=replace-with-brevo-api-key
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=587
NUXT_SMTP_FROM="Aparts CRM <noreply@example.com>"
NUXT_SMTP_USER=noreply@example.com
NUXT_SMTP_PASSWORD=replace-with-smtp-password
NUXT_SMTP_SECURE=false

NUXT_VAPID_SUBJECT=mailto:admin@example.com
NUXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
NUXT_VAPID_PUBLIC_KEY=replace-with-the-same-vapid-public-key
NUXT_VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# Promote only this existing active administrator to platform superuser.
SUPERUSER_EMAIL=

# Google Cloud Translation Basic v2 (server only).
NUXT_GOOGLE_TRANSLATION_API_KEY=
# Shared monthly cap; 0 disables automatic translation. Maximum: 450000.
NUXT_GOOGLE_TRANSLATION_MONTHLY_CHARACTER_LIMIT=450000

# Public website: configure Settings → Website and the contact profile in the CRM.

# MagicMop landing reCAPTCHA v3 (server only; endpoint is disabled for Aparts).
NUXT_RECAPTCHA_SECRET_KEY=
NUXT_RECAPTCHA_ALLOWED_ORIGINS=https://magicmopcrm.com,https://www.magicmopcrm.com
NUXT_RECAPTCHA_MINIMUM_SCORE=0.5
# Telegram bot-token encryption, 32 random bytes as hex (openssl rand -hex 32)
NUXT_MESSAGING_ENCRYPTION_KEY=

# Calendly PAT: scheduled_events:read only. Never expose in public config.
NUXT_CALENDLY_API_TOKEN=
NUXT_CALENDLY_EVENT_NAME=Демо MagicMop
