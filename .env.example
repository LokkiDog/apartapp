# ── Экземпляр CRM и PostgreSQL ──
# Для Aparts используйте порт 2000 и базу aparts на 55432.
# Для MagicMop используйте порт 2002 и базу magicmop на 52951.
CRM_BRAND=aparts
DATABASE_URL=postgres://aparts:aparts@localhost:55432/aparts
MAGICMOP_POSTGRES_PASSWORD=
NUXT_PUBLIC_APP_URL=http://localhost:2000
ORGANIZATION_NAME=Aparts

# ── Сессии и первый администратор ──
# SUPERUSER_EMAIL повышает существующего активного администратора указанной базы.
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
SUPERUSER_EMAIL=admin@example.com

# ── Почта ──
# Локальные письма можно проверять в Mailpit на http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@aparts.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
NUXT_BREVO_API_KEY=

# ── Push-уведомления ──
# Публичные VAPID-ключи сервера и приложения должны совпадать.
NUXT_VAPID_SUBJECT=mailto:admin@example.com
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=

# ── Telegram ──
# Ключ шифрования — 32 случайных байта в hex (openssl rand -hex 32).
# Для Telegram webhook укажите в NUXT_PUBLIC_APP_URL публичный HTTPS-адрес.
NUXT_MESSAGING_ENCRYPTION_KEY=

# Поиск и определение адреса (Geoapify).
# Серверный ключ. Лимит на одну базу за сутки UTC.
NUXT_GEOAPIFY_API_KEY=
NUXT_GEOAPIFY_DAILY_REQUEST_LIMIT=1000

# ── Google Cloud Translation ──
# Серверный API-ключ. Лимит 0 отключает перевод, максимальный лимит — 450000 символов в месяц.
NUXT_GOOGLE_TRANSLATION_API_KEY=
NUXT_GOOGLE_TRANSLATION_MONTHLY_CHARACTER_LIMIT=450000

# ── MagicMop — лендинг ──
# Секрет reCAPTCHA и токен Calendly остаются на сервере.
NUXT_RECAPTCHA_SECRET_KEY=
NUXT_RECAPTCHA_ALLOWED_ORIGINS=https://magicmopcrm.com,https://www.magicmopcrm.com
NUXT_RECAPTCHA_MINIMUM_SCORE=0.5
NUXT_CALENDLY_API_TOKEN=
NUXT_CALENDLY_EVENT_NAME=Демо MagicMop
