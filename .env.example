DATABASE_URL=postgres://aparts:aparts@localhost:55432/aparts
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=Администратор
ORGANIZATION_NAME=Aparts
NUXT_PUBLIC_APP_NAME=Aparts
NUXT_PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@aparts.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
NUXT_BREVO_API_KEY=
NUXT_VAPID_SUBJECT=mailto:admin@example.com
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=

# Promote only this existing active administrator to platform superuser.
SUPERUSER_EMAIL=admin@example.com

# Google Cloud Translation Basic v2 (server only).
NUXT_GOOGLE_TRANSLATION_API_KEY=
# Shared monthly cap; 0 disables automatic translation. Maximum: 450000.
NUXT_GOOGLE_TRANSLATION_MONTHLY_CHARACTER_LIMIT=450000

# MagicMop landing reCAPTCHA v3 (server only; endpoint is disabled for Aparts).
NUXT_RECAPTCHA_SECRET_KEY=
NUXT_RECAPTCHA_ALLOWED_ORIGINS=https://magicmopcrm.com,https://www.magicmopcrm.com
NUXT_RECAPTCHA_MINIMUM_SCORE=0.5
# Telegram token encryption, 32 random bytes encoded as hex (openssl rand -hex 32)
NUXT_MESSAGING_ENCRYPTION_KEY=
# NUXT_PUBLIC_APP_URL must use public HTTPS for Telegram webhooks.

# Calendly PAT: scheduled_events:read only. Never expose in public config.
NUXT_CALENDLY_API_TOKEN=
NUXT_CALENDLY_EVENT_NAME=Демо MagicMop
